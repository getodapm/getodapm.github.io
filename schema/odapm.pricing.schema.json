{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odapm.org/schema/odapm.pricing.schema.json",
  "title": "ODAPM Priced Model (odapm/v1)",
  "description": "A complete ODAPM model instance: meta + scope items carrying market-derived prices. Tax lives separately in tax.json.",
  "type": "object",
  "required": [
    "meta",
    "items"
  ],
  "additionalProperties": true,
  "definitions": {
    "price": {
      "type": "object",
      "description": "Price shape. rem=remove unit price, rep=replace unit price, mat=taxable material portion per unit. null = not yet priced.",
      "properties": {
        "rem": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "rep": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "mat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "catPrice": {
      "type": "object",
      "description": "Category-tiered price (water cat 1/2/3).",
      "properties": {
        "cat1": {
          "$ref": "#/definitions/price"
        },
        "cat2": {
          "$ref": "#/definitions/price"
        },
        "cat3": {
          "$ref": "#/definitions/price"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schema",
        "version"
      ],
      "properties": {
        "schema": {
          "const": "odapm/v1"
        },
        "version": {
          "type": "string"
        },
        "model_name": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "default": "USD"
        },
        "region": {
          "type": "string"
        },
        "base_location": {
          "type": "string"
        },
        "labor_basis": {
          "type": "object",
          "description": "Local labor cost(s) used to derive prices, with source.",
          "properties": {
            "rate": {
              "type": [
                "number",
                "null"
              ],
              "description": "Fully-burdened hourly labour cost used to derive prices."
            },
            "source": {
              "type": "string",
              "description": "Cited public wage series and vintage, e.g. 'BLS OEWS Denver-Aurora-Lakewood, May 2025, construction laborers'."
            },
            "burden_pct": {
              "type": [
                "number",
                "null"
              ],
              "description": "Disclosed burden applied over base wage, as a percentage. A contractor input, not open data."
            }
          }
        },
        "margin_target": {
          "type": [
            "number",
            "string",
            "null"
          ],
          "description": "DEPRECATED - misleading name, kept so existing models still validate. Use markup_target. Where both are present, markup_target wins."
        },
        "escalated": {
          "type": [
            "string",
            "null"
          ],
          "description": "Date prices were last re-indexed (ISO yyyy-mm-dd). null until first priced. Convenience mirror of the most recent meta.escalations entry."
        },
        "note": {
          "type": "string"
        },
        "markup_target": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Markup applied to derived cost, as a fraction (0.25 = cost x 1.25). This is a MARKUP, not a margin: to hit a target margin m use m/(1-m), so a 20% margin is 0.25. A discretionary contractor input, disclosed rather than derived."
        },
        "escalations": {
          "type": "array",
          "description": "Append-only escalation history. Every run of tools/escalate.py adds an entry so the path from the originally derived price to the current one is auditable.",
          "items": {
            "type": "object",
            "required": [
              "date",
              "labor",
              "labor_series",
              "materials",
              "materials_series"
            ],
            "properties": {
              "date": {
                "type": "string",
                "description": "ISO yyyy-mm-dd the escalation was applied."
              },
              "labor": {
                "type": "number",
                "description": "Fractional wage-index change applied, e.g. 0.021."
              },
              "labor_series": {
                "type": "string",
                "description": "Cited series and vintage, e.g. 'BLS ECI, construction, 2026Q2'."
              },
              "materials": {
                "type": "number",
                "description": "Fractional materials-index change applied."
              },
              "materials_series": {
                "type": "string",
                "description": "Cited series and vintage."
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "group",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "price": {
            "oneOf": [
              {
                "$ref": "#/definitions/price"
              },
              {
                "$ref": "#/definitions/catPrice"
              }
            ],
            "description": "Flat price shape, or a category-tiered map for categoryPriced items."
          },
          "priceByCategory": {
            "type": "object",
            "description": "Used when scope item is categoryPriced. Tier set keyed by category.",
            "properties": {
              "cat1": {
                "$ref": "#/definitions/price"
              },
              "cat2": {
                "$ref": "#/definitions/price"
              },
              "cat3": {
                "$ref": "#/definitions/price"
              }
            },
            "additionalProperties": false
          },
          "basis": {
            "type": "string",
            "description": "Inputs + sources used to derive the price. REQUIRED for conformance on any item carrying a non-zero price - see the Conformance section of SPEC.md. JSON Schema cannot express that condition; tools/validate.py enforces it."
          }
        }
      }
    }
  }
}
