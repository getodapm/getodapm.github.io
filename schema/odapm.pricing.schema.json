{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odapm.org/schema/odapm.pricing.schema.json",
  "title": "ODAPM Priced Model (odapm/v1)",
  "description": "A complete ODAPM model instance: meta + scope items carrying market-derived prices. Tax lives separately in tax.json.",
  "type": "object",
  "required": [
    "meta",
    "items"
  ],
  "additionalProperties": true,
  "definitions": {
    "price": {
      "type": "object",
      "description": "Price shape. rem=remove unit price, rep=replace unit price, mat=taxable material portion per unit. null = not yet priced.",
      "properties": {
        "rem": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "rep": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "mat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "catPrice": {
      "type": "object",
      "description": "Category-tiered price (water cat 1/2/3).",
      "properties": {
        "cat1": {
          "$ref": "#/definitions/price"
        },
        "cat2": {
          "$ref": "#/definitions/price"
        },
        "cat3": {
          "$ref": "#/definitions/price"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schema",
        "version"
      ],
      "properties": {
        "schema": {
          "const": "odapm/v1"
        },
        "version": {
          "type": "string"
        },
        "model_name": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "default": "USD"
        },
        "region": {
          "type": "string"
        },
        "base_location": {
          "type": "string"
        },
        "labor_basis": {
          "type": "object",
          "description": "Local labor cost(s) used to derive prices, with source."
        },
        "margin_target": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "escalated": {
          "type": [
            "string",
            "null"
          ],
          "description": "Date prices were last re-indexed (ISO yyyy-mm-dd). null until first priced."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "group",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "price": {
            "oneOf": [
              {
                "$ref": "#/definitions/price"
              },
              {
                "$ref": "#/definitions/catPrice"
              }
            ],
            "description": "Flat price shape, or a category-tiered map for categoryPriced items."
          },
          "priceByCategory": {
            "type": "object",
            "description": "Used when scope item is categoryPriced. Tier set keyed by category.",
            "properties": {
              "cat1": {
                "$ref": "#/definitions/price"
              },
              "cat2": {
                "$ref": "#/definitions/price"
              },
              "cat3": {
                "$ref": "#/definitions/price"
              }
            },
            "additionalProperties": false
          },
          "basis": {
            "type": "string",
            "description": "Inputs + sources used to derive the price (labor hrs, material qty/cost, equipment share, markup, index source). Makes the number auditable."
          }
        }
      }
    }
  }
}